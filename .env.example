# Public (browser / future admin)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only — webhook inserts. Never expose to the client or NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Shared secret for Supabase Edge Function → app reprocess API (min 16 chars).
# Must match Edge Function secret REPROCESS_SECRET.
REPROCESS_SECRET=replace_with_long_random_secret
